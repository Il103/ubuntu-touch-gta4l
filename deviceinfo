# Device info for Samsung Galaxy Tab A7 10.4 (2020) - LTE Edition
# Model: SM-T505N | Codename: gta4l

deviceinfo_format_version="1"
deviceinfo_name="Samsung Galaxy Tab A7 (LTE)"
deviceinfo_manufacturer="Samsung"
deviceinfo_codename="gta4l"
deviceinfo_year="2020"
deviceinfo_arch="aarch64"

# Bootloader & Kernel (Tweak for SM-T505N Modem)
# ضفت لك androidboot.selinux=permissive عشان الأوبونتو ميتحبسش في الأول
deviceinfo_kernel_cmdline="console=ttyMSM0,115200n8 earlycon=msm_geni_serial,0x4a90000 androidboot.hardware=qcom androidboot.console=ttyMSM0 androidboot.memcg=1 loop.max_part=7 androidboot.selinux=permissive"
deviceinfo_generate_bootimg="true"
deviceinfo_bootimg_qcdt="false"
deviceinfo_bootimg_pagesize="4096"

# الأوفستس دي "مقدسة" لسلسلة الـ T50x عشان الـ Odin والـ Fastboot يقبلوها
deviceinfo_bootimg_base="0x00000000"
deviceinfo_bootimg_kernel_offset="0x00008000"
deviceinfo_bootimg_ramdisk_offset="0x01000000"
deviceinfo_bootimg_tags_offset="0x00000100"

# Display (الـ Resolution الصح للـ T505N)
deviceinfo_screen_width="1200"
deviceinfo_screen_height="2000"
deviceinfo_screen_ppi="224"

# Flash methods
deviceinfo_flash_method="fastboot"
deviceinfo_flash_pagesize="4096"

# Halium specs
deviceinfo_halium_version="11" # جرب 11 لو 12 عملت Error 2
deviceinfo_halium_build_syspart="true"
